{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "samflix-launcher",
  "mainBinaryName": "samflix-launcher",
  "version": "0.1.0",
  "identifier": "mc.samflix.launcher",
  "build": {
    "frontendDist": "../../web/dist/launcher/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../web start",
    "beforeBuildCommand": "pnpm --dir ../web build"
  },
  "app": {
    "windows": [
      {
        "title": "samflix-mc",
        "width": 900,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://mc-heads.net; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
