# Clé d'API CurseForge, à demander sur https://console.curseforge.com/
#
# Facultative : Modrinth est consulté en premier et couvre la quasi-totalité
# des mods. La clé ne sert que pour ceux qui n'y sont pas publiés, et elle est
# nominative — elle ne se versionne pas et ne s'embarque pas dans le binaire.
#
# Le launcher la lit dans cette variable, ou dans
# ~/.config/samflix-mc/curseforge.key.
CURSEFORGE_API_KEY=

# Remontée des incidents vers Sentry. Mettre 0 pour la couper entièrement :
# plus aucun événement ne quitte la machine, les journaux restent locaux.
SAMFLIX_TELEMETRY=1

# Projet Sentry de destination. Vide par défaut = celui compilé dans le
# binaire. À renseigner pour router les incidents d'un déploiement ailleurs.
SENTRY_DSN=

# Verbosité de la console. Le fichier de journal garde le détail quoi qu'il
# arrive. Exemples : info | debug | mc_mods=debug,mc_pack=debug
RUST_LOG=
