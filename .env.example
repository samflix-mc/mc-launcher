# Clé d'API CurseForge, à demander sur https://console.curseforge.com/
#
# Facultative : Modrinth est consulté en premier et couvre la quasi-totalité
# des mods. La clé ne sert que pour ceux qui n'y sont pas publiés, et elle est
# nominative — elle ne se versionne pas et ne s'embarque pas dans le binaire.
#
# Le launcher la lit dans cette variable, ou dans
# ~/.config/samflix-mc/curseforge.key.
CURSEFORGE_API_KEY=
