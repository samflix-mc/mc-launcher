# Met le trousseau du système hors circuit : la session Microsoft passe alors
# par ~/.config/samflix-mc/session.json, en 0600.
#
# Utile sur un poste où le portefeuille est plus une gêne qu'un service — un
# kdewallet chiffré par GPG redemande sa phrase à chaque accès. Les suites du
# dépôt la posent systématiquement : le fichier s'isole en déplaçant
# XDG_CONFIG_HOME, le trousseau non, et « mc-auth logout » effacerait la vraie
# session du poste qui lance les tests.
SAMFLIX_SANS_TROUSSEAU=

# Remontée des incidents vers Sentry. Mettre 0 pour la couper entièrement :
# plus aucun événement ne quitte la machine, les journaux restent locaux.
SAMFLIX_TELEMETRY=1

# Projet Sentry de destination. Vide par défaut = celui compilé dans le
# binaire. À renseigner pour router les incidents d'un déploiement ailleurs.
SENTRY_DSN=

# Environnement de déploiement : local | development | preproduction | production
# (dev, preprod, staging et prod sont acceptés comme alias).
#
# Décrit un déploiement, pas un profil de compilation : un cargo build --release
# lancé sur un poste reste « local ». La CI le fixe à la compilation, cette
# variable le surcharge au lancement — utile pour rejouer un binaire de
# production sans salir la production.
SAMFLIX_ENV=

# Verbosité de la console. Le fichier de journal garde le détail quoi qu'il
# arrive. Exemples : info | debug | mc_mods=debug,mc_pack=debug
RUST_LOG=
